# SMTP-Konfiguration für E-Mail-Versand
# Kopiere diese Datei zu .env und fülle die Werte aus

# SMTP-Server (Gmail Beispiel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP-Anmeldedaten
# WICHTIG: Für Gmail musst du ein App-Passwort verwenden, nicht dein normales Passwort!
SMTP_USER=deine-email@gmail.com
SMTP_PASSWORD=dein-app-passwort

# Absender-E-Mail (kann gleich SMTP_USER sein)
FROM_EMAIL=deine-email@gmail.com

# Admin-E-Mail (erhält Benachrichtigungen über neue Registrierungen)
ADMIN_EMAIL=admin@bottle-trade.de

# Firebase Credentials (optional)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
