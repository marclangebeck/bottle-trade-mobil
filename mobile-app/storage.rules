rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}

// ============================================================================
// PRODUKTIONS-REGELN (mit Firebase Auth)
// Diese Rules sollten verwendet werden, sobald Firebase Auth aktiviert ist
// ============================================================================
/*
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Weinbilder: Jeder kann lesen, nur authentifizierte User können schreiben/löschen
    match /wines/{imageId} {
      // Lese-Zugriff: Öffentlich (alle können Bilder ansehen)
      allow read: if true;
      
      // Schreib-Zugriff: Nur authentifizierte User
      allow write: if request.auth != null;
      
      // Lösch-Zugriff: Nur authentifizierte User (kann später eingeschränkt werden auf eigene Bilder)
      allow delete: if request.auth != null;
    }
    
    // User-Profilbilder: Jeder kann lesen, nur authentifizierte User können schreiben/löschen
    match /users/{userId}/{imageId} {
      // Lese-Zugriff: Öffentlich
      allow read: if true;
      
      // Schreib-Zugriff: Nur der Besitzer oder Admin
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.admin == true
      );
      
      // Lösch-Zugriff: Nur der Besitzer oder Admin
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.admin == true
      );
    }
    
    // Fallback: Kein Zugriff auf andere Pfade
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
*/

